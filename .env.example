# Copy this file to .env.local and fill in your values.

# Database — create a free one at https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token

PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
# A restricted key (rk_...) also works above. Paystack signs webhooks with the
# SECRET key, so when using a restricted key, set this to your sk_... secret key:
PAYSTACK_WEBHOOK_SECRET=

# First owner account — run "npm run create-owner" once after setting these.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=choose-a-strong-password-min-10-chars

SESSION_SECRET=generate-a-long-random-hex-string

# Email via Resend (https://resend.com) — SMTP_PASS is your Resend API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM="The Growth Jar <orders@yourdomain.com>"

 #  set paystack webhook "https://your-vercel-domain/api/paystack/webhook"